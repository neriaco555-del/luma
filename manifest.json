{
  "manifest_version": 3,
  "name": "Luma – עוזר אישי לדפי אינטרנט",
  "version": "0.1.0",
  "description": "מסביר בשפה פשוטה מה האתר רוצה ממך, ועוזר למלא טפסים.",
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Luma – עזרה עם הדף הזה" },
  "side_panel": { "default_path": "panel.html" },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+L" },
      "description": "פתיחת Luma"
    }
  }
}
